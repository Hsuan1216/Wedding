<!DOCTYPE html>
<html lang="zh-TW" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hsin Chia & Yi Hsuan Wedding Invitation</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Noto+Serif+TC:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        morandi: {
                            clay: '#d4a373',
                            clayLight: '#e8cbb1',
                            sage: '#8da399',
                            sageLight: '#c2cfc9',
                            bg: '#faf8f5',
                            text: '#2c322e',
                            muted: '#6c7570'
                        }
                    },
                    fontFamily: {
                        serif: ['"Cormorant Garamond"', '"Noto Serif TC"', 'serif'],
                        tc: ['"Noto Serif TC"', 'serif']
                    }
                }
            }
        }
    </script>
    
    <style>
        body {
            font-family: 'Noto Serif TC', serif;
            background-color: #faf8f5;
            color: #2c322e;
            overflow-x: hidden;
        }

        .font-cormorant {
            font-family: 'Cormorant Garamond', serif;
        }

        /* Glassmorphism Navigation */
        .glass-nav {
            background: rgba(250, 248, 245, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(212, 163, 119, 0.2);
        }

        /* Hero Text Gradient Overlay */
        .hero-overlay {
            background: linear-gradient(180deg, rgba(44, 50, 46, 0.3) 0%, rgba(44, 50, 46, 0.6) 100%);
        }

        /* Countdown Card Box Shadow */
        .glow-card {
            background: #ffffff;
            box-shadow: 0 10px 30px rgba(212, 163, 115, 0.15), 0 2px 8px rgba(0, 0, 0, 0.03);
            border: 1px solid rgba(212, 163, 115, 0.15);
        }

        /* Mobile No-Wrap Protection */
        .no-wrap {
            white-space: nowrap !important;
            display: inline-block;
        }

        /* V-Card Shadow */
        .v-card-shadow {
            box-shadow: 0 20px 40px -15px rgba(141, 163, 153, 0.2);
        }

        /* Accordion transition */
        .accordion-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s cubic-bezier(0, 1, 0, 1);
        }

        .accordion-content.open {
            max-height: 1000px;
            transition: max-height 0.5s ease-in-out;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #faf8f5;
        }
        ::-webkit-scrollbar-thumb {
            background: #d4a373;
            border-radius: 4px;
        }
    </style>
</head>
<body class="antialiased selection:bg-morandi-clayLight selection:text-morandi-text">

